<svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGradientSmall" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#C8973A;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#D4A763;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#B8852E;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <rect width="32" height="32" rx="6" fill="url(#bgGradientSmall)"/>
  
  <!-- Cadre autour du 3S -->
  <rect x="3" y="8" width="16" height="16" rx="3" fill="none" stroke="#FFFFFF" stroke-width="0.8" opacity="0.5"/>
  
  <!-- "3S" dominant pour favicon -->
  <text x="11" y="20" font-family="Arial Black, sans-serif" font-size="10" font-weight="900" fill="#FFFFFF" text-anchor="middle">
    3S
  </text>
  
  <!-- "B" petit -->
  <text x="26" y="20" font-family="Arial, sans-serif" font-size="6" font-weight="600" fill="#FFFFFF" text-anchor="middle" opacity="0.8">
    B
  </text>
</svg>
